curl 'https://yuanbao.tencent.com/api/user/agent/conversation/v2/detail' \
  -H 'Content-Type: application/json' \
  -H 'Cookie: [REDACTED - 请替换或移除]' \
  -H 'Authorization: [REDACTED - 请替换或移除]' \
  --data-raw '{"conversationId":"sample_conversation_001"}'

