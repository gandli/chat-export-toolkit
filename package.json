{
  "name": "chat-export-toolkit",
  "version": "0.6.0",
  "description": "Export/copy current Yuanbao conversation and export all conversations as ZIP (MD/JSON/DOCX)",
  "author": "gandli",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:extension": "bun run --cwd ./extension build",
    "build:check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-monkey": "^5.0.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.2.0"
}
